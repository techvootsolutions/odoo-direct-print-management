<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="printer_configuration_company_rule" model="ir.rule">
        <field name="name">Printer Configuration: multi-company</field>
        <field name="model_id" ref="model_printer_configuration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="printer_configuration_user_rule" model="ir.rule">
        <field name="name">Printer Configuration: user access</field>
        <field name="model_id" ref="model_printer_configuration"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
    </record>
    <record id="group_pdf_preview" model="res.groups">
        <field name="name">Manage Pdf Preview</field>
    </record>
</odoo>
